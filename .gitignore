# Solo los documentos fuente; las capturas y los respaldos quedan locales.
/docs/**/*
!/docs/**/
!/docs/**/*.md
!/docs/**/*.txt
!/docs/**/*.json
!/docs/**/*.csv
!/docs/**/*.svg
/android/firma-che-contame/*
